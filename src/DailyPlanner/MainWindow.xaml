<Window
    x:Class="DailyPlanner.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Daily Planner">

    <Grid x:Name="RootGrid" Background="{ThemeResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Soft purple glow at the top, like the website -->
        <Rectangle Grid.RowSpan="2" IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.55,-0.08" RadiusX="0.55" RadiusY="0.42" GradientOrigin="0.55,-0.08">
                    <GradientStop Color="{ThemeResource GlowColor}" Offset="0" />
                    <GradientStop Color="#006D5CFF" Offset="1" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Custom title bar -->
        <Grid x:Name="AppTitleBar" Padding="18,0,140,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/Logo64.png" Width="20" Height="20" />
                <TextBlock Text="Daily Planner" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Frame x:Name="RootFrame" Grid.Row="1" />
    </Grid>
</Window>
