<Application
    x:Class="DailyPlanner.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Brand purple (same as the website) -->
            <Color x:Key="SystemAccentColor">#6D5CFF</Color>
            <Color x:Key="SystemAccentColorLight1">#7F70FF</Color>
            <Color x:Key="SystemAccentColorLight2">#9688FF</Color>
            <Color x:Key="SystemAccentColorLight3">#B3A9FF</Color>
            <Color x:Key="SystemAccentColorDark1">#5B4AE6</Color>
            <Color x:Key="SystemAccentColorDark2">#4A3BC4</Color>
            <Color x:Key="SystemAccentColorDark3">#3A2E9E</Color>

            <!-- Lane colors -->
            <SolidColorBrush x:Key="GamingBrush" Color="#3987E5" />
            <SolidColorBrush x:Key="SleepBrush" Color="#E8692F" />
            <SolidColorBrush x:Key="CodingBrush" Color="#1BAF7A" />
            <SolidColorBrush x:Key="BrandBrush" Color="#6D5CFF" />
            <SolidColorBrush x:Key="StreakBrush" Color="#F08C2E" />

            <!-- Rounded card look used on every page -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="20" />
            </Style>
            <Style x:Key="Eyebrow" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="80" />
                <Setter Property="Foreground" Value="{StaticResource BrandBrush}" />
            </Style>
            <Style x:Key="Muted" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
