            <!-- The website's font (Geist, free under the SIL Open Font License) -->
            <FontFamily x:Key="GeistFont">ms-appx:///Assets/Fonts/Geist-Variable.ttf#Geist</FontFamily>
            <FontFamily x:Key="GeistMono">ms-appx:///Assets/Fonts/GeistMono-Variable.ttf#Geist Mono</FontFamily>
            <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/Geist-Variable.ttf#Geist</FontFamily>

            <!-- Softer, rounder controls -->
            <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">14</CornerRadius>
            <Thickness x:Key="ButtonPadding">14,8,14,9</Thickness>

            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource GeistFont}" />
            </Style>

            <!-- Rounded card look used on every page -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource PanelBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource LineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="Padding" Value="22" />
            </Style>
            <Style x:Key="Eyebrow" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource GeistMono}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="100" />
                <Setter Property="Foreground" Value="{ThemeResource AccentTextBrush}" />
            </Style>
            <Style x:Key="Muted" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource GeistFont}" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
