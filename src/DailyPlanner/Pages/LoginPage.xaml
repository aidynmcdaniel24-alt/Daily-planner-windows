<Page
    x:Class="DailyPlanner.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="24" MinHeight="680">
            <StackPanel MaxWidth="420" HorizontalAlignment="Stretch" VerticalAlignment="Center" Spacing="16">

                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                    <Image Source="ms-appx:///Assets/Logo64.png" Width="34" Height="34" />
                    <TextBlock Text="Daily Planner" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>

                <Border Style="{StaticResource Card}" Padding="26">
                    <StackPanel Spacing="14">
                        <SelectorBar x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged" HorizontalAlignment="Center">
                            <SelectorBarItem x:Name="LoginTab" Text="Log in" IsSelected="True" />
                            <SelectorBarItem x:Name="SignupTab" Text="Sign up" />
                        </SelectorBar>

                        <StackPanel x:Name="Body" Spacing="14">
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="Title" Text="Welcome back" FontSize="28" FontWeight="Bold" CharacterSpacing="-20" HorizontalAlignment="Center" />
                                <TextBlock x:Name="Sub" Text="Log in to sync your plan across devices." Style="{StaticResource Muted}" HorizontalAlignment="Center" TextAlignment="Center" />
                            </StackPanel>

                            <TextBox x:Name="Email" Header="Email" PlaceholderText="you@example.com" InputScope="EmailSmtpAddress" KeyDown="Field_KeyDown" />
                            <PasswordBox x:Name="Password" Header="Password" PlaceholderText="Your password" KeyDown="Field_KeyDown" PasswordChanged="Password_Changed" />
                            <TextBlock x:Name="Rules" Visibility="Collapsed" FontSize="12" Style="{StaticResource Muted}" Text="8+ characters, with a letter and a number" />

                            <InfoBar x:Name="Message" IsClosable="False" IsOpen="False" />

                            <Button x:Name="Go" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Height="40" Click="Go_Click" CornerRadius="10">
                                <Grid>
                                    <TextBlock x:Name="GoText" Text="Log in" />
                                    <ProgressRing x:Name="GoBusy" IsActive="False" Width="18" Height="18" Foreground="White" />
                                </Grid>
                            </Button>
                            <HyperlinkButton x:Name="Forgot" Content="Forgot password?" HorizontalAlignment="Center" Click="Forgot_Click" />

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="OR" FontSize="11" Style="{StaticResource Muted}" />
                                <Rectangle Grid.Column="2" Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Center" />
                            </Grid>

                            <Button x:Name="Google" HorizontalAlignment="Stretch" Height="40" CornerRadius="10" Click="Google_Click">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="G" FontWeight="Bold" Foreground="#4285F4" />
                                    <TextBlock x:Name="GoogleText" Text="Continue with Google" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <HyperlinkButton x:Name="Guest" Content="Continue without an account" HorizontalAlignment="Center" Click="Guest_Click" />
                <TextBlock Text="By signing up, you agree to the Terms of Use and Privacy Policy. You must be 13 or older." FontSize="12" Style="{StaticResource Muted}" TextAlignment="Center" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
