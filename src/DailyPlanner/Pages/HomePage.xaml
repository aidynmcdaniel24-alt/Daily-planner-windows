<Page
    x:Class="DailyPlanner.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="Root" Padding="36,28,36,36" Spacing="18" MaxWidth="1100">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection><EntranceThemeTransition IsStaggeringEnabled="True" /></TransitionCollection>
            </StackPanel.ChildrenTransitions>

            <!-- Greeting -->
            <StackPanel Spacing="4">
                <TextBlock x:Name="DateText" Style="{StaticResource Eyebrow}" />
                <TextBlock x:Name="Hello" FontSize="38" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="SubText" Text="Here's your plan for today." Style="{StaticResource Muted}" FontSize="15" />
                <StackPanel x:Name="Goals" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0" />
            </StackPanel>

            <InfoBar x:Name="SetupBar" IsOpen="False" IsClosable="True" Severity="Informational"
                     Title="Make the plan yours"
                     Message="Answer a few setup questions on the website to get drills for your game and your own bedtime routine.">
                <InfoBar.ActionButton>
                    <Button Content="Open setup" Click="Setup_Click" />
                </InfoBar.ActionButton>
            </InfoBar>

            <InfoBar x:Name="VerifyBar" IsOpen="False" IsClosable="True" Severity="Warning"
                     Title="Please verify your email" Message="Check your inbox for the link.">
                <InfoBar.ActionButton>
                    <Button Content="Resend email" Click="Resend_Click" />
                </InfoBar.ActionButton>
            </InfoBar>

            <Grid x:Name="TopGrid" ColumnSpacing="18" RowSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Next up -->
                <Border x:Name="NextCard" CornerRadius="14" Padding="22" BorderThickness="1" VerticalAlignment="Stretch"
                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" Opacity="0.22">
                            <GradientStop Color="#6D5CFF" Offset="0" />
                            <GradientStop Color="Transparent" Offset="0.8" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock x:Name="NextLabel" Text="NEXT UP" Style="{StaticResource Eyebrow}" />
                            <TextBlock x:Name="NextTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="NextNote" Style="{StaticResource Muted}" />
                        </StackPanel>
                        <Button x:Name="NextDone" Grid.Column="1" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center" Padding="16,9" Click="NextDone_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE73E;" FontSize="14" />
                                <TextBlock Text="Done" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Today's progress -->
                <Border x:Name="TodayCard" Grid.Column="1" Style="{StaticResource Card}">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="116" Height="116" VerticalAlignment="Center">
                            <ProgressRing x:Name="AllRing" IsIndeterminate="False" Width="116" Height="116" Value="0" Maximum="100" />
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="AllPct" Text="0%" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="today" FontSize="12" Style="{StaticResource Muted}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <StackPanel x:Name="Lanes" Grid.Column="1" Spacing="4" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Quote -->
            <Border Style="{StaticResource Card}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="6">
                        <TextBlock Text="QUOTE OF THE HOUR" Style="{StaticResource Eyebrow}" />
                        <TextBlock x:Name="QuoteText" FontSize="18" TextWrapping="Wrap" />
                        <TextBlock x:Name="QuoteBy" Style="{StaticResource Muted}" />
                    </StackPanel>
                    <Button Grid.Column="1" VerticalAlignment="Top" ToolTipService.ToolTip="New quote" Click="NewQuote_Click">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    </Button>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
