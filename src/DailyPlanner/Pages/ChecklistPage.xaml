<Page
    x:Class="DailyPlanner.Pages.ChecklistPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="Root" Padding="36,28,36,36" Spacing="16" MaxWidth="820" HorizontalAlignment="Stretch">
            <!-- Header -->
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="IconBox" Width="48" Height="48" CornerRadius="12">
                    <FontIcon x:Name="Icon" FontSize="22" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="Heading" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock x:Name="SubHeading" Style="{StaticResource Muted}" />
                </StackPanel>
                <Border x:Name="StreakPill" Grid.Column="2" CornerRadius="99" Padding="12,5" VerticalAlignment="Center"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <TextBlock x:Name="StreakText" FontSize="13" FontWeight="SemiBold" />
                </Border>
            </Grid>

            <!-- Progress -->
            <Border Style="{StaticResource Card}" Padding="20,16">
                <StackPanel Spacing="10">
                    <Grid>
                        <TextBlock x:Name="CountText" FontWeight="SemiBold" />
                        <TextBlock x:Name="PctText" HorizontalAlignment="Right" Style="{StaticResource Muted}" />
                    </Grid>
                    <ProgressBar x:Name="Bar" Maximum="100" Height="8" CornerRadius="4" />
                </StackPanel>
            </Border>

            <!-- Tasks -->
            <Border Style="{StaticResource Card}" Padding="8,6">
                <StackPanel x:Name="TaskList">
                    <StackPanel.ChildrenTransitions>
                        <TransitionCollection><EntranceThemeTransition IsStaggeringEnabled="True" /></TransitionCollection>
                    </StackPanel.ChildrenTransitions>
                </StackPanel>
            </Border>

            <TextBlock x:Name="Hint" Style="{StaticResource Muted}" FontSize="12"
                       Text="To change these tasks, use Edit tasks on the website. Changes show up here automatically." />
        </StackPanel>
    </ScrollViewer>
</Page>
