<Page
    x:Class="DailyPlanner.Pages.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar (built in code) -->
        <Border x:Name="Sidebar" Margin="12,0,0,12" CornerRadius="18" Padding="10,12,10,12" BorderThickness="1"
                Background="{ThemeResource SidebarBrush}" BorderBrush="{ThemeResource LineBrush}" Width="236" />

        <Grid Grid.Column="1">
            <Frame x:Name="PageFrame" />
            <!-- Pops up when a checklist is finished -->
            <InfoBar x:Name="Toast" IsOpen="False" Severity="Success" IsClosable="True" CornerRadius="14"
                     HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="24" MaxWidth="460" />
            <Button x:Name="ExitFocus" Content="Exit focus mode" Style="{StaticResource AccentButtonStyle}" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24" Padding="18,10" CornerRadius="10" Click="ExitFocus_Click" />
            <!-- Saving indicator -->
            <Border x:Name="SyncBadge" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,22,0"
                    Padding="10,5,12,6" CornerRadius="99" Background="{ThemeResource PanelBrush}" BorderBrush="{ThemeResource LineBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressRing x:Name="SyncRing" IsActive="False" Width="12" Height="12" />
                    <TextBlock Text="Saving" FontSize="12" Style="{StaticResource Muted}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
